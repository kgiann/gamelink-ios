<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard" version="3.0" toolsVersion="24765" targetRuntime="AppleTV" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="GLTV-LAUNCH-VC">
    <device id="appleTV" appearance="dark"/>
    <dependencies>
        <deployment identifier="tvOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen View Controller-->
        <scene sceneID="GLTV-LAUNCH-SCENE">
            <objects>
                <viewController id="GLTV-LAUNCH-VC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="GLTV-LAUNCH-VIEW">
                        <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="GLTV-LAUNCH-IMG">
                                <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="GLTV-LAUNCH-SAFE"/>
                        <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="GLTV-LAUNCH-IMG" firstAttribute="leading" secondItem="GLTV-LAUNCH-VIEW" secondAttribute="leading" id="GLTV-c1"/>
                            <constraint firstItem="GLTV-LAUNCH-IMG" firstAttribute="top" secondItem="GLTV-LAUNCH-VIEW" secondAttribute="top" id="GLTV-c2"/>
                            <constraint firstAttribute="bottom" secondItem="GLTV-LAUNCH-IMG" secondAttribute="bottom" id="GLTV-c3"/>
                            <constraint firstAttribute="trailing" secondItem="GLTV-LAUNCH-IMG" secondAttribute="trailing" id="GLTV-c4"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="GLTV-LAUNCH-RESP" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="1280" height="720"/>
    </resources>
</document>
